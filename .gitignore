# Application Data: everything a run writes under the default data root is
# private (prompts, papers, proofs, indexes, installation identity), so the
# root is deny-by-default and only the tracked .gitkeep placeholders remain.
backend/data/*
!backend/data/.gitkeep
!backend/data/auto_final_answer/
backend/data/auto_final_answer/*
!backend/data/auto_final_answer/.gitkeep
!backend/data/proofs/
backend/data/proofs/*
!backend/data/proofs/.gitkeep
!backend/data/user_uploads/
backend/data/user_uploads/*
!backend/data/user_uploads/.gitkeep
**/.moto_installation_binding.json

